# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-5

# Immich
IMMICH_API_KEY=your_immich_api_key
IMMICH_URL=http://immich_server:2283
IMMICH_ALBUM_ID=your_album_uuid

# Anki API
ANKI_DB_PATH=/anki-data/collection.anki2
ANKI_SYNC_CONTAINER=anki-sync
ANKI_API_KEY=changeme_long_random_string

# Card Maker API
CARD_MAKER_API_KEY=changeme_long_random_string

# Caddy (only needed if using Cloudflare DNS-01 challenge)
CLOUDFLARE_API_TOKEN=your_cloudflare_token

# n8n
N8N_HOST=flow.your.domain.com
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Vaultwarden
VAULTWARDEN_ADMIN_TOKEN=changeme
DOMAIN=https://vault.your.domain.com

# CouchDB (Obsidian LiveSync)
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=changeme

# Paperless
PAPERLESS_SECRET_KEY=changeme_long_random_string
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
PAPERLESS_URL=https://docs.your.domain.com
